APP_ENV=local
APP_PORT=8081

LOG_LEVEL=info
LOG_FORMAT=json

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=rusuh_booking
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_TIMEOUT_SECONDS=5

# Valkey / Redis
VALKEY_ADDR=localhost:6379
VALKEY_PASSWORD=
VALKEY_TLS=false

# Kafka (Confluent managed — SASL/TLS for production)
KAFKA_BROKERS=localhost:29092
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_TLS=false

# Access Token JWT (shared secret with queue-service — HS256)
ACCESS_TOKEN_SECRET=changeme_shared_secret_with_queue_service

# Dukcapil Mock internal endpoint
DUKCAPIL_BASE_URL=http://localhost:8085
DUKCAPIL_TIMEOUT_MS=3000
DUKCAPIL_FAIL_OPEN=true

# Midtrans
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxx
MIDTRANS_ENV=sandbox

# Gmail SMTP (App Password — bukan password login)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your@gmail.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM=Rusuh Booking Tiket <noreply@gmail.com>

# SSE stok
SSE_HEARTBEAT_SECONDS=30
